# Copy to .env.deploy.local (gitignored) and fill in before running `npm run deploy:web`.
# Used by scripts/deploy-web.sh.

# Passcode gate hash baked into the build (see reference_passcode_gate memory).
VITE_PASSCODE_HASH=

# Vercel auth + project link. Alternatively run `npx vercel login` and
# `npx vercel link` once, then you can omit these.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
